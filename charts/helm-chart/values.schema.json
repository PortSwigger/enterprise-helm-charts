{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "services": {
      "type": "object",
      "properties": {
        "webServer": {
          "type": "object",
          "properties": {
            "annotations": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "type": {
              "type": "string",
              "enum": ["", "ClusterIP", "LoadBalancer", "NodePort"]
            }
          }
        }
      }
    },
    "scanningSharedSecret": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" }
      }
    },
    "relaySharedSecret": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" }
      }
    }
  }
}
